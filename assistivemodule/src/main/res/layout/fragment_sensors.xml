<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal_50"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Title / Local label -->
        <TextView
            android:id="@+id/txtLightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Light Level (from cloud)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <!-- Value coming from Firebase -->
        <TextView
            android:id="@+id/txtFromFirebase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cloud Value: — lx"
            android:textSize="18sp"
            android:textColor="@color/darker_gray"
            android:layout_marginTop="12dp" />

        <!-- Optional timestamp -->
        <TextView
            android:id="@+id/txtUpdatedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated: —"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginTop="8dp" />

        <!-- Small loading indicator while first read happens -->
        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
