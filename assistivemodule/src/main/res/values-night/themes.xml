<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme for Night -->
    <style name="Theme.SmartAssistiveSystem" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Disable action bar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Primary colors for dark theme -->
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/purple_200</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- NoActionBar variant -->
    <style name="Theme.SmartAssistiveSystem.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Splash Theme (Night) -->
    <style name="Theme.SmartAssistiveSystem.Splash" parent="Theme.SplashScreen">
        <!-- Dark splash background -->
        <item name="windowSplashScreenBackground">@color/black</item>
        <!-- Use a separate night splash icon -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_splash</item>
        <!-- After splash, fall back to night theme -->
        <item name="postSplashScreenTheme">@style/Theme.SmartAssistiveSystem</item>
    </style>

</resources>
